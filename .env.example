# Copy to `.env` and fill in. Never commit `.env`.

# Required — admin password. 12+ random chars recommended.
# The /api/login endpoint is rate-limited to 5 attempts/min per IP.
ADMIN_PASSWORD=change-me-please-123!

# Required only if you access the site via HTTPS (reverse proxy, Cloudflare Tunnel).
# Leave commented out (or set to "false") for LAN access at http://<nas-ip>:3000,
# otherwise the browser will silently reject the session cookie and login will
# appear to succeed but every save will fail with 401.
# COOKIE_SECURE=true

# Optional — if unset, a random one is generated and persisted to ./data/session.secret.
# Only set explicitly if you need a known value (e.g. multi-replica deployments).
# SESSION_SECRET=

# Optional overrides
# PORT=3000
# NODE_ENV=production
